# =============================================================================
# ContaHub — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite o .env.local — ele está no .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de Dados (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/contahub?schema=public"

# -----------------------------------------------------------------------------
# Autenticação (Clerk)
# https://dashboard.clerk.com → seu app → API Keys
# -----------------------------------------------------------------------------
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."

# -----------------------------------------------------------------------------
# Storage de Documentos (Supabase)
# https://supabase.com → seu projeto → Settings → API
# -----------------------------------------------------------------------------
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
SUPABASE_BUCKET="documents"

# -----------------------------------------------------------------------------
# WhatsApp (WAHA — self-hosted)
# Rode localmente: docker run -p 3000:3000 devlikeapro/waha
# -----------------------------------------------------------------------------
WAHA_URL="http://localhost:3000"
WAHA_API_KEY="sua_api_key_aqui"
WAHA_SESSION="default"

# -----------------------------------------------------------------------------
# Jobs / Filas (BullMQ + Redis)
# Redis local: docker compose -f docker-compose.yml up -d
# Redis produção: provisionar no Railway
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
JOBS_PORT="3003"

# -----------------------------------------------------------------------------
# Bull Board — Painel de monitoramento de filas
# Acesse: http://localhost:3003/queues
# Header obrigatório: x-api-key: <valor abaixo>
# -----------------------------------------------------------------------------
BULL_BOARD_API_KEY="contahub-local"

# -----------------------------------------------------------------------------
# E-mail Transacional (Resend) — Sprint 2
# https://resend.com → API Keys
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL=""
# -----------------------------------------------------------------------------
# Storage alternativo (Cloudflare R2) — opcional
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="contahub-documents"

# -----------------------------------------------------------------------------
# URLs da aplicação
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3010"
NEXT_PUBLIC_API_URL="http://localhost:3002"
NODE_ENV="development"


# ──  ──────────────────────────────────────────────────────────
CERTIFICATE_ENCRYPTION_KEY=api_key
SUPABASE_CERTIFICATES_BUCKET=certificates
ECAC_TEST_PASSWORD=qualquer_valor_de_teste


